// HRMS — skema basis data
//
// Satu basis data PostgreSQL, satu schema per modul (PLAN/12 §3.1 aturan 3).
// Schema adalah "jahitan" yang membuat pemecahan menjadi service kelak murah:
// memindahkan satu modul berarti memindahkan satu schema, bukan membongkar tabel.
//
// Aturan yang mengikat berkas ini:
//   - Setiap tabel milik tenant WAJIB punya `tenantId` dan kebijakan RLS.
//     RLS ditulis manual di migrasi (Prisma tidak membangkitkannya). Ada gerbang
//     CI yang menolak tabel ber-tenantId tanpa policy — lihat packages/db/test.
//   - Uang memakai Decimal, tidak pernah Float.
//   - Data berdimensi waktu ditutup periodenya, tidak pernah di-UPDATE di tempat (P13).
//   - Migrasi hanya aditif (P12, PLAN/09). Linter di ops/scripts memblokir DROP/RENAME.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["tenant", "auth", "iam", "audit", "messaging", "platform", "employee", "notification", "attendance", "leave", "payroll"]
}

// =============================================================================
// SCHEMA: tenant — tenant, paket, dan modul yang dilanggan
// =============================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CHURNED

  @@schema("tenant")
}

enum ModuleTier {
  CORE // selalu aktif, tidak dapat dinonaktifkan
  BASIC
  ADVANCED
  ULTIMATE
  INDUSTRY

  @@schema("tenant")
}

enum TenantModuleStatus {
  ENABLED
  DISABLED

  @@schema("tenant")
}

/// Katalog modul. Global (bukan milik tenant), karena ini definisi produk.
model Module {
  code        String     @id
  name        String
  description String?
  tier        ModuleTier
  /// Modul CORE tidak pernah dapat dinonaktifkan; EntitlementGuard melewatinya.
  isCore      Boolean    @default(false) @map("is_core")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")

  planModules   PlanModule[]
  tenantModules TenantModule[]
  permissions   Permission[]
  menus         Menu[]

  @@map("modules")
  @@schema("tenant")
}

/// Paket langganan. Memetakan tiering produk referensi (Basic/Advanced/Ultimate).
model Plan {
  code        String   @id
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  modules PlanModule[]
  tenants Tenant[]

  @@map("plans")
  @@schema("tenant")
}

model PlanModule {
  planCode   String @map("plan_code")
  moduleCode String @map("module_code")

  plan   Plan   @relation(fields: [planCode], references: [code], onDelete: Cascade)
  module Module @relation(fields: [moduleCode], references: [code], onDelete: Cascade)

  @@id([planCode, moduleCode])
  @@map("plan_modules")
  @@schema("tenant")
}

/// Baris jangkar untuk seluruh sistem. Setiap tabel ber-tenantId menunjuk ke sini.
model Tenant {
  id       String       @id @default(uuid()) @db.Uuid
  /// Dipakai saat login bersama email. Huruf kecil, tanpa spasi.
  code     String       @unique
  name     String
  status   TenantStatus @default(TRIAL)
  planCode String       @map("plan_code")

  /// Nama zona IANA, mis. `Asia/Jakarta`. Menentukan batas hari kerja.
  ///
  /// Disimpan sebagai nama, bukan offset. Offset angka benar hari ini dan salah
  /// pada hari pertama aturan zona berubah — dan yang menanggungnya adalah rekap
  /// kehadiran yang sudah terlanjur dihitung dengan batas hari yang bergeser.
  timezone String @default("Asia/Jakarta")

  /// Akhir masa uji coba. Null berarti bukan trial.
  trialEndsAt DateTime? @map("trial_ends_at")
  suspendedAt DateTime? @map("suspended_at")
  churnedAt   DateTime? @map("churned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan    Plan           @relation(fields: [planCode], references: [code])
  modules TenantModule[]
  users   User[]
  roles   Role[]

  @@index([status])
  @@map("tenants")
  @@schema("tenant")
}

/// Modul yang benar-benar aktif untuk satu tenant. Sumber kebenaran entitlement.
///
/// Menonaktifkan modul menulis status DISABLED — barisnya tidak pernah dihapus,
/// sehingga data modul tetap utuh dan pulih saat diaktifkan kembali (PLAN/12 F6 DoD).
model TenantModule {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  moduleCode String             @map("module_code")
  status     TenantModuleStatus @default(ENABLED)
  enabledAt  DateTime?          @map("enabled_at")
  disabledAt DateTime?          @map("disabled_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  tenantRef Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    Module @relation(fields: [moduleCode], references: [code])

  @@unique([tenantId, moduleCode])
  @@index([tenantId, status])
  @@map("tenant_modules")
  @@schema("tenant")
}

// =============================================================================
// SCHEMA: auth — identitas dan sesi
// =============================================================================

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@schema("auth")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(ACTIVE)

  /// Dipakai untuk kunci akun sementara. Direset saat login berhasil.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantRef     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  actionTokens  ActionToken[]
  roles         UserRole[]
  grants        UserPermissionGrant[]
  accessVersion AccessVersion?

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
  @@schema("auth")
}

/// Refresh token dengan rotasi dan deteksi pencurian (PLAN/06 §3.5).
///
/// Satu login membuat satu `familyId`. Setiap refresh menerbitkan token baru dalam
/// keluarga yang sama dan menandai yang lama `replacedByTokenId`. Bila token yang
/// SUDAH digantikan dipakai lagi, itu tanda kebocoran: seluruh keluarga dicabut.
model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  /// SHA-256 dari token. Token mentah tidak pernah disimpan.
  tokenHash String @unique @map("token_hash")
  familyId  String @map("family_id") @db.Uuid

  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("auth")
}

// =============================================================================
// SCHEMA: iam — peran, permission, menu, grant per pengguna (PLAN/05)
// =============================================================================

enum GrantEffect {
  GRANT
  DENY

  @@schema("iam")
}

/// Katalog permission. Global — ini definisi produk, bukan data tenant.
///
/// Setiap permission dimiliki satu modul. Itulah yang membuat P8 bekerja:
/// permission dari modul yang tidak dilanggan gugur saat resolusi, tanpa
/// perlu mencabut peran siapa pun.
model Permission {
  code        String  @id
  moduleCode  String  @map("module_code")
  description String?

  module          Module                @relation(fields: [moduleCode], references: [code], onDelete: Cascade)
  rolePermissions RolePermission[]
  userGrants      UserPermissionGrant[]
  menus           Menu[]

  @@index([moduleCode])
  @@map("permissions")
  @@schema("iam")
}

/// Katalog menu. Global. Pohon menu efektif dirakit per pengguna saat bootstrap.
///
/// Menu bukan otorisasi — ia kenyamanan (P9). `permissionCode` menentukan apakah
/// item dirender; gateway tetap memeriksa permission yang sama secara mandiri.
model Menu {
  id             String  @id @default(uuid()) @db.Uuid
  code           String  @unique
  label          String
  parentId       String? @map("parent_id") @db.Uuid
  moduleCode     String  @map("module_code")
  /// Menu tanpa permission (mis. grup pembungkus) selalu tampil bila anaknya tampil.
  permissionCode String? @map("permission_code")
  path           String?
  icon           String?
  sortOrder      Int     @default(0) @map("sort_order")
  isActive       Boolean @default(true) @map("is_active")

  module     Module      @relation(fields: [moduleCode], references: [code], onDelete: Cascade)
  permission Permission? @relation(fields: [permissionCode], references: [code])
  parent     Menu?       @relation("MenuTree", fields: [parentId], references: [id])
  children   Menu[]      @relation("MenuTree")

  @@index([parentId])
  @@index([moduleCode])
  @@map("menus")
  @@schema("iam")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  /// Peran sistem dibuat saat provisioning dan tidak dapat dihapus tenant.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantRef   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
  @@schema("iam")
}

model RolePermission {
  tenantId       String @map("tenant_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@index([tenantId])
  @@map("role_permissions")
  @@schema("iam")
}

model UserRole {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
  @@schema("iam")
}

/// Hak akses khusus per pengguna, di luar perannya (PLAN/05 §4).
///
/// DENY selalu menang atas GRANT dan atas peran. Grant kedaluwarsa diabaikan saat
/// resolusi, bukan dihapus — jejaknya tetap ada untuk access review.
model UserPermissionGrant {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  permissionCode String      @map("permission_code")
  effect         GrantEffect

  /// Wajib diisi. Grant tanpa alasan tidak dapat ditinjau ulang enam bulan kemudian.
  reason    String
  grantedBy String    @map("granted_by") @db.Uuid
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@unique([userId, permissionCode])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("user_permission_grants")
  @@schema("iam")
}

/// Penanda versi untuk cache akses efektif (PLAN/05 §5.1).
///
/// Setiap perubahan peran/grant menaikkan versi dalam transaksi yang sama.
/// Klien cache membandingkan versi, bukan menunggu TTL — sehingga pencabutan
/// akses berlaku seketika, bukan 60 detik kemudian.
model AccessVersion {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @id @map("user_id") @db.Uuid
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("access_versions")
  @@schema("iam")
}

// =============================================================================
// SCHEMA: audit — jejak append-only (P5)
// =============================================================================

/// Append-only. Tidak ada UPDATE maupun DELETE — ditegakkan trigger di migrasi,
/// bukan kesepakatan. Retensi 7 tahun (PLAN/00 §4).
model AuditLog {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid

  /// Null untuk aksi sistem (job terjadwal, konsumer event).
  actorUserId String? @map("actor_user_id") @db.Uuid
  action      String
  entityType  String  @map("entity_type")
  entityId    String? @map("entity_id")

  /// Hanya kolom yang berubah, bukan seluruh baris.
  before Json?
  after  Json?

  ip            String?
  userAgent     String? @map("user_agent")
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("audit")
}

// =============================================================================
// SCHEMA: messaging — transactional outbox (PLAN/03 §1.3)
// =============================================================================

/// Event ditulis ke tabel ini DALAM transaksi bisnis yang sama, lalu dipublikasikan
/// terpisah oleh worker. Ini yang membuat "data berubah tetapi event hilang" mustahil.
///
/// Bentuknya sengaja identik dengan versi terdistribusi: saat modul dipecah menjadi
/// service, yang berubah hanya tujuan publikasinya (PLAN/12 §9).
model OutboxMessage {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  topic   String
  payload Json

  correlationId String? @map("correlation_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@index([tenantId, topic])
  @@map("outbox_messages")
  @@schema("messaging")
}

// =============================================================================
// SCHEMA: platform — control plane (PLAN/07)
// =============================================================================

/// Superuser adalah entitas di bidang berbeda, bukan pengguna dengan izin lebih
/// banyak (P11). Tabel ini sengaja tidak punya `tenantId` dan tidak boleh berisi
/// satu pun data pribadi karyawan tenant.
///
/// MFA wajib: constraint di migrasi menolak baris aktif tanpa `totpSecret`.
model Superuser {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String  @map("password_hash")
  fullName     String  @map("full_name")
  totpSecret   String? @map("totp_secret")
  isActive     Boolean @default(false) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("superusers")
  @@schema("platform")
}

/// Jejak aksi superuser. Terpisah total dari `audit.audit_logs` milik tenant.
///
/// Dipisah karena pelakunya bukan pengguna tenant: mencampurnya akan membuat
/// audit tenant memuat aktor yang tidak dapat mereka kenali, sekaligus memberi
/// tenant jendela ke operasi internal platform.
///
/// `detail` tidak boleh berisi data pribadi karyawan tenant — hanya identifier
/// dan metadata. Sama seperti seluruh schema ini (PLAN/07 §2).
model PlatformAuditLog {
  id          BigInt   @id @default(autoincrement())
  superuserId String   @map("superuser_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  detail      Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([superuserId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("platform_audit_logs")
  @@schema("platform")
}

enum ActionTokenPurpose {
  PASSWORD_RESET
  INVITATION

  @@schema("auth")
}

/// Token sekali pakai untuk reset kata sandi dan undangan pengguna.
///
/// Satu tabel untuk dua keperluan, bukan dua tabel yang 90% identik. Bentuknya
/// memang sama persis — token acak, satu pengguna, masa berlaku, sekali pakai —
/// dan alasan yang sama dipakai dokumen `08` §5.1 untuk menyatukan reimbursement
/// dengan SPPD ke dalam satu service.
///
/// Yang berbeda hanya masa berlakunya, dan itu parameter, bukan tabel baru.
model ActionToken {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  purpose   ActionTokenPurpose
  /// SHA-256. Token mentah hanya pernah ada di email penerimanya.
  tokenHash String             @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  /// Diisi saat dipakai. Token yang sudah terpakai tidak pernah dihapus —
  /// jejaknya dibutuhkan saat menyelidiki pengambilalihan akun.
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, purpose])
  @@index([expiresAt])
  @@map("action_tokens")
  @@schema("auth")
}

// =============================================================================
// SCHEMA: employee — data karyawan (Fase 2)
// =============================================================================

enum EmployeeStatus {
  PROBATION
  ACTIVE
  RESIGNED
  TERMINATED

  @@schema("employee")
}

enum EmploymentType {
  PKWTT // tetap
  PKWT  // kontrak berjangka
  MAGANG
  HARIAN
  BORONGAN

  @@schema("employee")
}

enum Gender {
  MALE
  FEMALE

  @@schema("employee")
}

/// Struktur organisasi sebagai jalur termaterialisasi.
///
/// `path` menyimpan garis keturunan lengkap ("/ops/hr/recruit"), sehingga
/// "seluruh bawahan departemen X" menjadi satu `LIKE 'X/%'` alih-alih rekursi.
/// Cetak biru menyebut `ltree`; jalur termaterialisasi memberi manfaat yang sama
/// tanpa ekstensi PostgreSQL dan tanpa tipe yang tidak dikenal Prisma.
model Department {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  name     String
  parentId String? @map("parent_id") @db.Uuid
  path     String
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent      Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentTree")
  employments Employment[]

  @@unique([tenantId, code])
  @@index([tenantId, path])
  @@map("departments")
  @@schema("employee")
}

model Position {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  name     String
  /// Jenjang untuk pelaporan dan matriks persetujuan. Kecil = lebih senior.
  level    Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employments Employment[]

  @@unique([tenantId, code])
  @@map("positions")
  @@schema("employee")
}

/// Data karyawan.
///
/// Tiga kolom disimpan terenkripsi: NIK KTP, NPWP, dan nomor rekening. Ketiganya
/// cukup untuk membuka pinjaman atas nama seseorang, dan basis data yang bocor
/// tidak boleh menyerahkannya begitu saja (UU PDP No. 27/2022).
///
/// Setiap kolom terenkripsi berpasangan dengan indeks buta — HMAC dari nilai yang
/// dinormalkan. Itu yang membuat keunikan NIK tetap dapat ditegakkan basis data
/// dan pencarian "cari NIK ini" tetap mungkin, tanpa pernah mendekripsi apa pun.
model Employee {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Nomor induk yang diberikan perusahaan. Bukan NIK KTP.
  employeeNumber String @map("employee_number")
  fullName       String @map("full_name")

  nationalIdEncrypted String? @map("national_id_encrypted")
  nationalIdIndex     String? @map("national_id_index")
  taxIdEncrypted      String? @map("tax_id_encrypted")
  taxIdIndex          String? @map("tax_id_index")
  bankAccountEncrypted String? @map("bank_account_encrypted")

  /// Versi tersamar, dihitung sekali saat menulis dan disimpan apa adanya.
  ///
  /// Ada supaya tampilan bagi pembaca tanpa izin `employee.pii.unmask` tidak
  /// perlu mendekripsi apa pun. Menyamarkan hasil dekripsi terdengar setara,
  /// tetapi berarti nilai lengkapnya pernah berada di memori proses — dan dari
  /// sana ia ikut masuk ke log galat, dump heap, atau jejak APM pertama yang
  /// menangkapnya. Daftar karyawan juga jalur terpanas di modul ini; tidak
  /// mendekripsi 500 baris untuk menampilkan bintang adalah keuntungan gratis.
  nationalIdMasked  String? @map("national_id_masked")
  taxIdMasked       String? @map("tax_id_masked")
  bankAccountMasked String? @map("bank_account_masked")
  bankName             String? @map("bank_name")
  bankAccountHolder    String? @map("bank_account_holder")

  email       String?
  phone       String?
  birthDate   DateTime? @map("birth_date") @db.Date
  birthPlace  String?   @map("birth_place")
  gender      Gender?
  address     String?

  joinDate   DateTime  @map("join_date") @db.Date
  resignDate DateTime? @map("resign_date") @db.Date
  status     EmployeeStatus @default(ACTIVE)

  /// Optimistic locking. Dua HR yang menyunting karyawan yang sama tidak boleh
  /// saling menimpa tanpa ada yang tahu (dok. 03 §4.6).
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employments Employment[]
  contracts   EmployeeContract[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, nationalIdIndex])
  @@index([tenantId, status])
  @@index([tenantId, fullName])
  @@map("employees")
  @@schema("employee")
}

/// Penempatan berbasis periode: siapa di departemen dan jabatan apa, sejak kapan.
///
/// Riwayat tidak pernah ditimpa (P13). Mutasi menutup baris berjalan dengan
/// `effectiveTo` dan membuka baris baru — sehingga pertanyaan "siapa kepala
/// departemen ini bulan Maret lalu" tetap dapat dijawab tahun depan.
model Employment {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  departmentId String @map("department_id") @db.Uuid
  positionId   String @map("position_id") @db.Uuid
  type         EmploymentType

  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// Null berarti masih berjalan. Tepat satu baris per karyawan boleh null —
  /// ditegakkan indeks unik parsial di migrasi.
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// Atasan langsung pada periode ini. Referensi lunak ke employee.
  managerId String? @map("manager_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])
  position   Position   @relation(fields: [positionId], references: [id])

  @@index([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, departmentId])
  @@map("employments")
  @@schema("employee")
}

/// Kontrak kerja.
///
/// `endDate` pada PKWT adalah alasan modul ini ditarik maju ke Fase 2: satu PKWT
/// yang lolos tanpa diperpanjang berubah menjadi PKWTT demi hukum, dan kerugiannya
/// permanen serta melebihi biaya langganan setahun (dokumen 08, A5).
model EmployeeContract {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  contractNumber String         @map("contract_number")
  type           EmploymentType
  startDate      DateTime       @map("start_date") @db.Date
  /// Null hanya sah untuk PKWTT — ditegakkan CHECK di migrasi.
  endDate        DateTime?      @map("end_date") @db.Date

  fileId String? @map("file_id")
  notes  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee  Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reminders ContractReminder[]

  @@unique([tenantId, contractNumber])
  @@index([tenantId, endDate])
  @@index([tenantId, employeeId, startDate])
  @@map("employee_contracts")
  @@schema("employee")
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  DISCARDED

  @@schema("employee")
}

enum ImportRowStatus {
  VALID
  ERROR
  COMMITTED

  @@schema("employee")
}

/// Satu unggahan berkas impor.
///
/// Impor selalu dua langkah: unggah lalu tinjau, baru simpan. Langkah pratinjau
/// bukan kenyamanan — ia satu-satunya cara membuat impor dapat dibatalkan.
/// Berkas Excel milik pelanggan hampir tidak pernah bersih pada percobaan pertama,
/// dan impor sekali jalan yang setengah berhasil meninggalkan basis data dalam
/// keadaan yang tidak diinginkan siapa pun serta sulit dikembalikan.
model ImportJob {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Jenis data yang diimpor. Untuk sekarang hanya "employee".
  kind     String
  fileName String @map("file_name")
  status   ImportStatus @default(PREVIEW)

  totalRows     Int @default(0) @map("total_rows")
  validRows     Int @default(0) @map("valid_rows")
  errorRows     Int @default(0) @map("error_rows")
  committedRows Int @default(0) @map("committed_rows")

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  committedAt DateTime? @map("committed_at")

  rows ImportRow[]

  @@index([tenantId, status, createdAt])
  @@map("import_jobs")
  @@schema("employee")
}

/// Satu baris dari berkas yang diunggah, beserta hasil validasinya.
///
/// Baris disimpan apa adanya dalam `raw` DAN dalam bentuk yang sudah dinormalkan
/// di `parsed`. Yang pertama supaya pesan galat dapat menunjuk persis apa yang
/// diketik pengguna di selnya; yang kedua supaya penyimpanan tidak perlu mengurai
/// ulang.
///
/// Baris bergalat tidak dibuang. Pengguna memperbaikinya di Excel lalu mengunggah
/// ulang, dan riwayat percobaan sebelumnya adalah yang menjelaskan mengapa jumlah
/// karyawan tidak cocok dengan jumlah baris berkas.
model ImportRow {
  id        BigInt @id @default(autoincrement())
  tenantId  String @map("tenant_id") @db.Uuid
  jobId     String @map("job_id") @db.Uuid
  /// Nomor baris di berkas asli, termasuk baris judul. Dipakai di pesan galat.
  rowNumber Int    @map("row_number")

  raw    Json
  parsed Json?
  errors Json?

  status ImportRowStatus @default(VALID)

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([tenantId, jobId, status])
  @@map("import_rows")
  @@schema("employee")
}

/// Ambang pengingat berakhirnya kontrak.
///
/// Tiga ambang, bukan satu. H-90 memberi ruang untuk memutuskan (perpanjang,
/// angkat tetap, atau lepas) dan menegosiasikannya. H-30 untuk menyiapkan
/// dokumennya. H-7 adalah peringatan terakhir sebelum PKWT berubah menjadi
/// PKWTT demi hukum — dan perubahan itu tidak dapat dibatalkan.
enum ReminderThreshold {
  D90
  D30
  D7
  EXPIRED

  @@schema("employee")
}

/// Catatan pengingat yang sudah dikirim.
///
/// Seluruh gunanya ada pada satu constraint: `@@unique([contractId, threshold])`.
/// Job pengingat berjalan setiap hari dan memindai rentang tanggal, bukan tanggal
/// persis — sebuah kontrak yang berakhir 90 hari lagi akan tetap masuk pindaian
/// besok dan lusa. Tanpa constraint ini, HR menerima pengingat yang sama setiap
/// hari selama tiga bulan, lalu berhenti membacanya sama sekali.
///
/// Barisnya juga yang menjawab "kenapa saya tidak pernah diberi tahu" saat sebuah
/// PKWT terlanjur lewat.
model ContractReminder {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  contractId String            @map("contract_id") @db.Uuid
  threshold  ReminderThreshold

  sentAt DateTime @default(now()) @map("sent_at")

  contract EmployeeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, threshold])
  @@index([tenantId, sentAt])
  @@map("contract_reminders")
  @@schema("employee")
}

// =============================================================================
// SCHEMA: notification — pengiriman keluar
// =============================================================================

enum NotificationChannel {
  EMAIL
  WEB_PUSH
  WHATSAPP

  @@schema("notification")
}

/// Satu langganan Web Push — satu peramban di satu perangkat.
///
/// Satu baris per LANGGANAN, bukan per pengguna: satu orang memakai ponsel dan
/// komputer kantor, masing-masing menghasilkan endpoint tersendiri, dan
/// mengirim hanya ke salah satunya berarti separuh notifikasi tidak sampai.
model PushSubscription {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  endpoint String @unique
  /// Kunci enkripsi milik peramban. Payload dienkripsi untuk penerimanya;
  /// layanan push di antaranya tidak dapat membacanya.
  p256dh   String
  auth     String

  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSuccessAt DateTime? @map("last_success_at")
  /// Langganan mati tidak melapor; ia hanya berhenti bekerja.
  failureCount  Int       @default(0) @map("failure_count")

  @@index([tenantId, userId])
  @@map("push_subscriptions")
  @@schema("notification")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@schema("notification")
}

/// Catatan setiap pesan yang dikirim keluar.
///
/// Alasan tabel ini ada tertulis di satu kolom: `dedupeKey`.
///
/// Outbox menjamin pengiriman **at-least-once**, bukan exactly-once. Konsumer
/// yang gagal setelah mengirim email tetapi sebelum meng-ack pesannya akan
/// menerima pesan yang sama lagi — dan mengirim email kedua. Untuk "pengingat
/// kontrak" itu menjengkelkan; untuk "kata sandi Anda telah direset" itu
/// membuat orang menelepon dukungan karena mengira akunnya diretas.
///
/// Kuncinya disisipkan lebih dulu dengan status PENDING. Bila penyisipan gagal
/// karena constraint unique, pesan itu sudah pernah ditangani dan konsumer
/// berhenti tanpa mengirim apa pun.
model NotificationLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  channel NotificationChannel
  topic   String
  /// Identitas peristiwa, bukan identitas pesan. Dua percobaan atas peristiwa
  /// yang sama menghasilkan kunci yang sama.
  dedupeKey String @map("dedupe_key")

  /// Alamat tujuan. Disimpan karena pertanyaan "ke mana pengingat itu dikirim"
  /// muncul setiap kali seseorang bilang tidak menerimanya.
  recipient String
  subject   String

  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  lastError String?            @map("last_error")

  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, createdAt])
  @@map("notification_logs")
  @@schema("notification")
}

// =============================================================================
// SCHEMA: attendance — presensi (Fase 3)
//
// Dokumen 10 mengikat seluruh schema ini lewat dua prinsip:
//
//   P14  Bukti presensi DINILAI, bukan dipercaya. Koordinat dan foto adalah
//        klaim perangkat yang dapat dipalsukan. Sistem memberi skor kepercayaan
//        dan menandai anomali untuk ditinjau manusia — bukan menerima atau
//        menolak otomatis berdasarkan satu sinyal.
//
//   P15  Pembatasan tujuan pada data lokasi. Lokasi diambil hanya saat presensi,
//        tidak pernah di latar belakang, dan tidak diteruskan ke pelaporan
//        sebagai koordinat mentah. Ini yang membedakan alat presensi dari alat
//        pengawasan.
// =============================================================================

enum PunchType {
  IN
  OUT
  BREAK_START
  BREAK_END

  @@schema("attendance")
}

enum PunchSource {
  /// Dari aplikasi web/PWA karyawan.
  WEB
  /// Aplikasi native (Fase 3 lanjutan).
  MOBILE
  /// Mesin fingerprint/face, lewat impor CSV atau webhook.
  DEVICE
  /// Diinput HR secara manual. Selalu ditandai untuk audit.
  MANUAL

  @@schema("attendance")
}

enum PunchReviewStatus {
  /// Skor kepercayaan memadai; tidak perlu tinjauan.
  ACCEPTED
  /// Ditandai untuk ditinjau HR. TETAP TERCATAT — tidak pernah dibuang.
  NEEDS_REVIEW
  APPROVED
  REJECTED

  @@schema("attendance")
}

enum DayStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HOLIDAY
  DAY_OFF

  @@schema("attendance")
}

/// Lokasi kerja beserta radius geofence.
///
/// Radius disimpan per lokasi, bukan global: kantor pusat di gedung bertingkat
/// membutuhkan radius jauh lebih kecil daripada area pabrik atau proyek lapangan.
/// Radius global memaksa memilih antara terlalu longgar untuk yang satu atau
/// terlalu ketat untuk yang lain.
model WorkSite {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  /// Radius dalam meter.
  radiusM   Int     @default(150) @map("radius_m")

  /// Ambang akurasi GPS yang masih diterima, dalam meter. GPS di dalam gedung
  /// kerap melaporkan akurasi 100 m atau lebih; menolaknya berarti menolak
  /// presensi seluruh kantor (risiko R43).
  maxAccuracyM Int @default(100) @map("max_accuracy_m")

  /// Office networks in CIDR form. A punch from one of these addresses counts as
  /// being on site even when its location evidence is thin, and it is what the
  /// FALLBACK_ONLY policy checks. Empty means unconfigured.
  ipRanges String[] @db.Inet @map("ip_ranges")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  punches PunchLog[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("work_sites")
  @@schema("attendance")
}

/// Pola jam kerja.
model Shift {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String

  /// Menit sejak tengah malam. Disimpan sebagai menit, bukan time, supaya shift
  /// malam yang melewati tengah malam (22:00-06:00) dapat dinyatakan tanpa
  /// tanggal — 1320 sampai 1800.
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  /// Toleransi keterlambatan dalam menit.
  graceMinutes Int @default(10) @map("grace_minutes")
  breakMinutes Int @default(60) @map("break_minutes")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schedules      Schedule[]
  attendanceDays AttendanceDay[]

  @@unique([tenantId, code])
  @@map("shifts")
  @@schema("attendance")
}

/// Jadwal shift seorang karyawan pada satu tanggal.
model Schedule {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  workDate   DateTime @map("work_date") @db.Date
  shiftId    String?  @map("shift_id") @db.Uuid
  /// Hari libur mingguan karyawan ini.
  isDayOff   Boolean  @default(false) @map("is_day_off")

  shift Shift? @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, workDate])
  @@index([tenantId, workDate])
  @@map("schedules")
  @@schema("attendance")
}

/// Kebijakan presensi per tenant (dokumen 10 §2.4).
///
/// "Keputusan ini milik tenant, bukan milik sistem — perusahaan konstruksi dan
/// perusahaan konsultan punya jawaban berbeda."
///
/// Ketiadaan barisnya berarti nilai bawaan, sehingga tenant yang tidak pernah
/// menyentuh layar setelan berperilaku persis seperti sebelum tabel ini ada.
model AttendancePolicy {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// `false` berarti ketiadaannya tidak menurunkan skor — bukan berarti
  /// buktinya diabaikan bila ada.
  requireLocation Boolean @default(true) @map("require_location")
  requirePhoto    Boolean @default(true) @map("require_photo")

  /// BLOCK, ALLOW_FLAGGED, atau FALLBACK_ONLY.
  onPermissionDenied String @default("ALLOW_FLAGGED") @map("on_permission_denied")

  /// Di bawah ambang ini, ketukan masuk antrean tinjauan HR.
  autoApproveThreshold Int @default(60) @map("auto_approve_threshold") @db.SmallInt
  photoRetentionDays   Int @default(90) @map("photo_retention_days")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("attendance_policies")
  @@schema("attendance")
}

/// Hari libur nasional dan cuti bersama.
model Holiday {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  date     DateTime @db.Date
  name     String
  /// Cuti bersama memotong hak cuti tahunan; libur nasional tidak.
  isJointLeave Boolean @default(false) @map("is_joint_leave")

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("holidays")
  @@schema("attendance")
}

/// Satu ketukan presensi, beserta seluruh buktinya.
///
/// Baris di sini TIDAK PERNAH dihapus dan tidak pernah ditolak otomatis. Presensi
/// di luar geofence tetap tercatat dan ditandai — karena karyawan yang benar-benar
/// bekerja di lokasi yang salah tetap bekerja, dan menghapus catatannya berarti
/// memotong gajinya berdasarkan sinyal yang mungkin salah (P14).
model PunchLog {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  type      PunchType
  source    PunchSource
  punchedAt DateTime @map("punched_at")
  /// Tanggal kerja yang dituju. Berbeda dari tanggal ketukan pada shift malam.
  workDate  DateTime @map("work_date") @db.Date

  // --- Bukti lokasi ----------------------------------------------------------
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  /// Akurasi yang dilaporkan perangkat, dalam meter.
  accuracyM  Int?     @map("accuracy_m")
  workSiteId String?  @map("work_site_id") @db.Uuid
  /// Jarak ke lokasi kerja terdekat, dalam meter. Dihitung saat menyimpan.
  distanceM  Int?     @map("distance_m")

  // --- Bukti foto ------------------------------------------------------------
  /// Kunci objek di penyimpanan. EXIF sudah dihapus sebelum disimpan.
  photoKey       String?   @map("photo_key")
  /// Foto dihapus setelah retensi habis; catatan presensinya tetap utuh.
  photoExpiresAt DateTime? @map("photo_expires_at")

  // --- Penilaian kepercayaan (P14) -------------------------------------------
  /// 0-100. Bukan ya/tidak: satu sinyal buruk tidak membatalkan presensi, dan
  /// beberapa sinyal buruk sekaligus yang menaikkan kecurigaan.
  trustScore Int   @default(100) @map("trust_score")
  /// Alasan pengurangan skor, sebagai daftar kode. Ditampilkan di antrean tinjauan.
  trustFlags Json? @map("trust_flags")

  review     PunchReviewStatus @default(ACCEPTED)
  reviewedBy String?           @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?         @map("reviewed_at")
  reviewNote String?           @map("review_note")

  /// Idempotensi antrean luring. Klien membangkitkannya sebelum mengirim, sehingga
  /// pengiriman ulang setelah jaringan pulih tidak menggandakan ketukan.
  dedupeKey String @map("dedupe_key")

  deviceInfo String?  @map("device_info")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  workSite WorkSite? @relation(fields: [workSiteId], references: [id])

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, employeeId, workDate])
  @@index([tenantId, review])
  @@index([tenantId, workDate])
  @@index([photoExpiresAt])
  @@map("punch_logs")
  @@schema("attendance")
}

/// Dokumen karyawan (PLAN/12 F2).
///
/// Isinya bukan lampiran biasa: pindaian KTP, kartu keluarga, ijazah, kontrak.
/// Seluruhnya data pribadi menurut UU PDP No. 27/2022, dan sebagiannya cukup
/// untuk membuka rekening bank atas nama orang lain.
///
/// Tidak pernah dihapus, hanya diarsipkan (aturan M4 dokumen 09). Berkas
/// fisiknya boleh hilang karena retensi; barisnya bertahan supaya riwayat
/// "pernah ada dokumen ini, diunggah oleh siapa" tidak ikut hilang.
model EmployeeDocument {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// KTP, KK, NPWP, IJAZAH, KONTRAK, SERTIFIKAT, LAINNYA.
  kind       String
  title      String
  fileName   String @map("file_name")
  /// Kunci objek di penyimpanan. Acak, bukan turunan dari id karyawan.
  storageKey String @unique @map("storage_key")
  mimeType   String @map("mime_type")
  sizeBytes  Int    @map("size_bytes")

  /// Untuk dokumen yang memang berumur — KITAS, SIM, kontrak. Null = abadi.
  expiresAt DateTime? @map("expires_at")

  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  archivedAt DateTime? @map("archived_at")
  archivedBy String?   @map("archived_by") @db.Uuid

  reminders DocumentReminder[]

  @@index([tenantId, employeeId])
  @@index([tenantId, expiresAt])
  @@map("employee_documents")
  @@schema("employee")
}

/// Pengingat yang sudah dikirim untuk satu dokumen pada satu ambang.
///
/// Unique (documentId, threshold) adalah kunci idempotensinya: pemindaian
/// harian yang menemukan dokumen yang sama setiap hari selama tiga bulan tetap
/// menghasilkan satu pengingat per ambang.
model DocumentReminder {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  documentId String            @map("document_id") @db.Uuid
  threshold  ReminderThreshold
  sentAt     DateTime          @default(now()) @map("sent_at")

  document EmployeeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, threshold])
  @@index([tenantId, sentAt])
  @@map("document_reminders")
  @@schema("employee")
}

/// Jejak pembacaan dokumen karyawan.
///
/// Sejajar dengan `PhotoAccessLog` dan untuk alasan yang sama: `audit_logs`
/// mencatat perubahan, sedangkan pertanyaan yang harus dapat dijawab di sini
/// adalah "siapa saja yang pernah membuka pindaian KTP saya".
model DocumentAccessLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  /// Pemilik dokumen, bukan yang mengaksesnya.
  employeeId String   @map("employee_id") @db.Uuid
  accessedBy String   @map("accessed_by") @db.Uuid
  /// VIEW, DOWNLOAD, atau EXPORT.
  action     String
  accessedAt DateTime @default(now()) @map("accessed_at")

  @@index([tenantId, employeeId, accessedAt])
  @@map("document_access_logs")
  @@schema("employee")
}

/// Persetujuan pemrosesan data presensi (dokumen 10 §8.2 PR2).
///
/// Terpisah dari persetujuan umum aplikasi, dan dapat ditarik. Keterpisahan itu
/// bukan pilihan tata letak: UU PDP No. 27/2022 menuntut persetujuan yang
/// spesifik per tujuan, dan kotak centang "Saya menyetujui syarat dan ketentuan"
/// bukan persetujuan atas pengambilan koordinat seseorang.
///
/// Versinya ikut disimpan karena persetujuan diberikan atas kalimat tertentu.
/// Ketika kalimatnya berubah — retensi diperpanjang, tujuan ditambah —
/// persetujuan atas kalimat lama tidak berlaku untuk yang baru.
model AttendanceConsent {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// LOCATION, PHOTO, atau BIOMETRIC.
  consentType String @map("consent_type")
  /// Versi teks persetujuan yang disetujui, mis. `2026-08-lokasi-v1`.
  version     String

  grantedAt   DateTime? @map("granted_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  ip          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, employeeId, consentType, version], map: "attendance_consents_tenant_employee_type_version_key")
  @@index([tenantId, employeeId])
  @@map("attendance_consents")
  @@schema("attendance")
}

/// Jejak pembacaan foto presensi (dokumen 10 §8.2 PR6).
///
/// Mencatat PEMBACAAN, bukan perubahan — karena itu tidak dapat digantikan
/// `audit_logs`, yang mencatat tindakan yang mengubah keadaan. "Siapa saja yang
/// pernah melihat foto saya" adalah pertanyaan yang berhak dijawab karyawan, dan
/// tidak ada tabel lain yang menyimpan jawabannya.
model PhotoAccessLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id") @db.Uuid
  punchId    String   @map("punch_id") @db.Uuid
  /// Pemilik foto, bukan yang mengaksesnya.
  employeeId String   @map("employee_id") @db.Uuid
  accessedBy String   @map("accessed_by") @db.Uuid
  /// VIEW, DOWNLOAD, atau EXPORT.
  action     String
  accessedAt DateTime @default(now()) @map("accessed_at")

  @@index([tenantId, employeeId, accessedAt])
  @@index([tenantId, accessedBy, accessedAt])
  @@map("photo_access_logs")
  @@schema("attendance")
}

/// Hasil kalkulasi harian per karyawan.
///
/// Diturunkan dari punch_logs, dan dapat dihitung ulang. Disimpan karena rekap
/// bulanan atas jutaan ketukan terlalu mahal untuk dihitung setiap kali dibuka —
/// dan karena payroll membutuhkan angka yang tidak berubah setelah periode ditutup.
model AttendanceDay {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  workDate   DateTime @map("work_date") @db.Date

  shiftId  String?   @map("shift_id") @db.Uuid
  checkIn  DateTime? @map("check_in")
  checkOut DateTime? @map("check_out")

  status          DayStatus
  lateMinutes     Int @default(0) @map("late_minutes")
  earlyMinutes    Int @default(0) @map("early_minutes")
  workMinutes     Int @default(0) @map("work_minutes")
  overtimeMinutes Int @default(0) @map("overtime_minutes")

  /// Diisi bila HR mengoreksi manual. Nilai asli tetap dapat dihitung ulang dari
  /// punch_logs, sehingga koreksi tidak pernah menghapus bukti.
  correctedBy    String?   @map("corrected_by") @db.Uuid
  correctedAt    DateTime? @map("corrected_at")
  correctionNote String?   @map("correction_note")

  /// Setelah periode ditutup, baris ini tidak boleh berubah lagi.
  isLocked Boolean @default(false) @map("is_locked")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shift Shift? @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, workDate])
  @@index([tenantId, workDate, status])
  @@map("attendance_days")
  @@schema("attendance")
}

/// Penutupan periode presensi.
///
/// Payroll membaca dari snapshot ini, bukan dari attendance_days langsung. Itu
/// yang membuat perhitungan gaji deterministik: koreksi presensi yang masuk
/// setelah periode ditutup tidak mengubah slip gaji yang sudah terbit.
model AttendancePeriod {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  year      Int
  month     Int
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  closedAt DateTime? @map("closed_at")
  closedBy String?   @map("closed_by") @db.Uuid

  /// Ringkasan per karyawan pada saat penutupan.
  snapshot Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, year, month])
  @@map("attendance_periods")
  @@schema("attendance")
}

// =============================================================================
// SCHEMA: leave — cuti, saldo, dan persetujuan
// =============================================================================

enum AccrualMethod {
  /// Jatah penuh diberikan di awal tahun.
  ANNUAL_GRANT
  /// Bertambah tiap bulan berjalan.
  MONTHLY_ACCRUAL
  /// Dihitung dari tanggal masuk kerja, bukan tahun kalender.
  ANNIVERSARY
  /// Tanpa batas — cuti sakit berbayar pada sebagian tenant.
  UNLIMITED
  /// Tidak berbasis saldo sama sekali, mis. cuti melahirkan.
  NONE

  @@schema("leave")
}

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  /// Sudah lewat dan benar-benar diambil. Dipakai payroll.
  TAKEN

  @@schema("leave")
}

/// Jenis cuti beserta kebijakan akrualnya.
model LeaveType {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String

  isPaid            Boolean       @default(true) @map("is_paid")
  accrualMethod     AccrualMethod @default(ANNUAL_GRANT) @map("accrual_method")
  defaultQuotaDays  Decimal       @default(12) @map("default_quota_days") @db.Decimal(5, 2)
  /// Sisa yang boleh dibawa ke tahun berikutnya. 0 berarti hangus.
  maxCarryOverDays  Decimal       @default(0) @map("max_carry_over_days") @db.Decimal(5, 2)
  /// Masa kerja minimum sebelum berhak. UU Ketenagakerjaan: 12 bulan untuk cuti tahunan.
  minServiceMonths  Int           @default(12) @map("min_service_months") @db.SmallInt
  requiresAttachment Boolean      @default(false) @map("requires_attachment")
  deductFromBalance Boolean       @default(true) @map("deduct_from_balance")
  affectsPayroll    Boolean       @default(false) @map("affects_payroll")
  colorHex          String        @default("#3b82f6") @map("color_hex")
  isActive          Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([tenantId, code])
  @@map("leave_types")
  @@schema("leave")
}

/// Saldo cuti seorang karyawan untuk satu jenis pada satu tahun.
///
/// `pending_days` ditahan saat PENGAJUAN, bukan saat persetujuan. Tanpa
/// penahanan, seseorang dapat mengajukan tiga cuti dua hari di atas saldo dua
/// hari — setiap pengajuan melihat saldo yang masih utuh karena belum ada satu
/// pun yang memotong.
///
/// `available_days` adalah kolom GENERATED di basis data, sengaja tidak
/// dideklarasikan di sini: rumus saldo yang hidup di dua tempat akan berbeda
/// pada hari seseorang menambahkan jenis mutasi baru. Bacanya lewat
/// `readBalances()` di `@hrms/core/leave`.
model LeaveBalance {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid
  leaveTypeId String @map("leave_type_id") @db.Uuid
  periodYear  Int    @map("period_year") @db.SmallInt

  entitledDays    Decimal @default(0) @map("entitled_days") @db.Decimal(6, 2)
  carriedOverDays Decimal @default(0) @map("carried_over_days") @db.Decimal(6, 2)
  adjustmentDays  Decimal @default(0) @map("adjustment_days") @db.Decimal(6, 2)
  usedDays        Decimal @default(0) @map("used_days") @db.Decimal(6, 2)
  pendingDays     Decimal @default(0) @map("pending_days") @db.Decimal(6, 2)
  expiredDays     Decimal @default(0) @map("expired_days") @db.Decimal(6, 2)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  ledger    BalanceLedger[]

  @@unique([tenantId, employeeId, leaveTypeId, periodYear], map: "leave_balances_tenant_employee_type_year_key")
  @@index([tenantId, employeeId])
  @@map("leave_balances")
  @@schema("leave")
}

/// Pengajuan cuti.
///
/// Tumpang tindih dicegah constraint EXCLUDE di basis data, bukan pemeriksaan
/// aplikasi. Pemeriksaan aplikasi selalu punya jendela antara membaca dan
/// menulis, dan dua pengajuan yang tiba bersamaan akan sama-sama membaca
/// "belum ada cuti di tanggal itu".
model LeaveRequest {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  requestNumber String @map("request_number")
  employeeId    String @map("employee_id") @db.Uuid
  leaveTypeId   String @map("leave_type_id") @db.Uuid

  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  isHalfDay     Boolean  @default(false) @map("is_half_day")
  totalDays     Decimal  @map("total_days") @db.Decimal(5, 2)
  reason        String
  attachmentKey String?  @map("attachment_key")

  status            RequestStatus @default(DRAFT)
  currentApproverId String?       @map("current_approver_id") @db.Uuid
  submittedAt       DateTime?     @map("submitted_at")
  decidedAt         DateTime?     @map("decided_at")
  version           Int           @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approvals   LeaveApproval[]
  attachments LeaveAttachment[]

  @@unique([tenantId, requestNumber])
  @@index([tenantId, employeeId, startDate])
  @@map("leave_requests")
  @@schema("leave")
}

/// Berkas lampiran pengajuan cuti — surat dokter, surat keterangan.
///
/// Berkasnya sendiri ada di penyimpanan blob; baris ini yang menghubungkannya
/// dengan karyawan dan pengajuannya, dan yang membuat "wajib melampirkan surat
/// dokter" berarti sesuatu. Sebelum tabel ini, syarat itu dipenuhi dengan
/// mengetik sembarang teks ke sebuah kotak isian.
model LeaveAttachment {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  employeeId String  @map("employee_id") @db.Uuid
  /// Diisi saat pengajuan dibuat. Null berarti lampiran yatim.
  requestId  String? @map("request_id") @db.Uuid

  /// Kunci objek di penyimpanan. Acak, bukan turunan dari id siapa pun.
  storageKey String @unique @map("storage_key")
  fileName   String @map("file_name")
  mimeType   String @map("mime_type")
  sizeBytes  Int    @map("size_bytes")

  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  request LeaveRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId])
  @@index([tenantId, requestId])
  @@map("leave_attachments")
  @@schema("leave")
}

/// Satu langkah dalam alur persetujuan berjenjang.
model LeaveApproval {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  requestId  String    @map("request_id") @db.Uuid
  stepOrder  Int       @map("step_order") @db.SmallInt
  approverId String    @map("approver_id") @db.Uuid
  /// APPROVED, REJECTED, atau DELEGATED. Null selama belum diputuskan.
  decision   String?
  comment    String?
  decidedAt  DateTime? @map("decided_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  request LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepOrder])
  @@map("leave_approvals")
  @@schema("leave")
}

/// Buku besar mutasi saldo.
///
/// Setiap perubahan saldo meninggalkan barisnya di sini tanpa kecuali. "Saldo
/// saya berkurang tiga hari padahal saya cuti dua" adalah pertanyaan yang tidak
/// dapat dijawab kolom angka — hanya oleh riwayat mutasinya.
model BalanceLedger {
  id        BigInt @id @default(autoincrement())
  tenantId  String @map("tenant_id") @db.Uuid
  balanceId String @map("balance_id") @db.Uuid

  /// GRANT, ACCRUAL, HOLD, RELEASE, CONSUME, EXPIRE, ADJUST.
  entryType String  @map("entry_type")
  /// Positif menambah saldo tersedia, negatif menguranginya.
  days      Decimal @db.Decimal(6, 2)

  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  note          String?
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  balance LeaveBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, balanceId, createdAt])
  @@map("balance_ledger")
  @@schema("leave")
}

// =============================================================================
// SCHEMA: payroll — komponen gaji, run, slip, dan jejak perhitungan
// =============================================================================
//
// Yang ada di sini KERANGKANYA saja. Aturan PPh21 dan BPJS tidak boleh
// ditambahkan tanpa Gerbang C (dokumen 12 §F5): ahli payroll terikat, 30 slip
// nyata sebagai kasus uji, dan spike S1 lulus 30/30.

enum ComponentType {
  EARNING
  DEDUCTION
  /// Iuran yang ditanggung perusahaan. Tidak mengurangi gaji bersih, tetapi
  /// wajib tampil di slip supaya karyawan melihat total biaya atas dirinya.
  EMPLOYER_CONTRIBUTION
  /// Hanya informasi, tidak masuk perhitungan.
  INFO

  @@schema("payroll")
}

enum CalcMethod {
  FIXED
  FORMULA
  PER_DAY
  PER_HOUR
  PERCENTAGE

  @@schema("payroll")
}

enum RunStatus {
  DRAFT
  CALCULATING
  CALCULATED
  FAILED
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED

  @@schema("payroll")
}

enum RunType {
  MONTHLY
  THR
  BONUS
  ADJUSTMENT

  @@schema("payroll")
}

/// Komponen gaji yang dapat dikonfigurasi tenant.
model PayrollComponent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String

  type       ComponentType
  calcMethod CalcMethod    @map("calc_method")

  amount            Decimal? @db.Decimal(18, 2)
  /// Ekspresi formula. Diurai parser berdaftar-izin, TIDAK PERNAH oleh `eval`.
  expression        String?
  rate              Decimal? @db.Decimal(9, 6)
  baseComponentCode String?  @map("base_component_code")

  taxable  Boolean @default(true)
  bpjsBase Boolean @default(false) @map("bpjs_base")

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  structures SalaryStructure[]
  lines      PayslipLine[]

  @@unique([tenantId, code])
  @@index([tenantId, sortOrder])
  @@map("components")
  @@schema("payroll")
}

/// Struktur gaji seorang karyawan, berperiode (P13).
///
/// Baris ditutup, tidak ditimpa. Kenaikan gaji bulan Juli tidak boleh mengubah
/// slip bulan Juni — dan slip Juni harus tetap dapat dihitung ulang dengan
/// angka yang berlaku saat itu.
model SalaryStructure {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid
  componentId String @map("component_id") @db.Uuid

  amount        Decimal?  @db.Decimal(18, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  note      String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  component PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, effectiveFrom], map: "salary_structures_tenant_employee_idx")
  @@map("salary_structures")
  @@schema("payroll")
}

/// Tarif pajak dan BPJS sebagai DATA berversi tanggal, bukan konstanta di kode.
///
/// `tenantId` null berarti nilai bawaan platform yang dibaca seluruh tenant.
/// Kebijakan RLS-nya membaca baris global tetapi hanya menulis baris sendiri —
/// tanpa pemisahan itu, satu tenant dapat mengubah tarif PPh21 tenant lain.
model StatutoryConfig {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  /// PPH21_TER, PTKP, BPJS_KES, BPJS_JHT, BPJS_JP, BPJS_JKK, BPJS_JKM, UMR.
  kind  String
  code  String
  value Json

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  /// Peraturan yang menjadi dasarnya. Wajib: angka pajak tanpa dasar hukum
  /// tidak dapat dipertanggungjawabkan saat diperiksa.
  legalBasis    String    @map("legal_basis")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, code, effectiveFrom], map: "statutory_configs_kind_effective_idx")
  @@map("statutory_configs")
  @@schema("payroll")
}

/// Satu putaran penggajian.
model PayrollRun {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  runNumber String  @map("run_number")
  runType   RunType @default(MONTHLY) @map("run_type")

  periodYear  Int       @map("period_year") @db.SmallInt
  periodMonth Int       @map("period_month") @db.SmallInt
  status      RunStatus @default(DRAFT)

  employeeCount  Int     @default(0) @map("employee_count")
  totalGross     Decimal @default(0) @map("total_gross") @db.Decimal(18, 2)
  totalDeduction Decimal @default(0) @map("total_deduction") @db.Decimal(18, 2)
  totalNet       Decimal @default(0) @map("total_net") @db.Decimal(18, 2)

  calculatedAt DateTime? @map("calculated_at")
  approvedAt   DateTime? @map("approved_at")
  approvedBy   String?   @map("approved_by") @db.Uuid
  paidAt       DateTime? @map("paid_at")
  lastError    String?   @map("last_error")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payslips Payslip[]

  @@unique([tenantId, runNumber])
  @@map("payroll_runs")
  @@schema("payroll")
}

/// Slip gaji seorang karyawan pada satu run.
model Payslip {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  runId      String @map("run_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  gross     Decimal @default(0) @db.Decimal(18, 2)
  deduction Decimal @default(0) @db.Decimal(18, 2)
  net       Decimal @default(0) @db.Decimal(18, 2)

  /// Potret data hulu saat dihitung. Perhitungan ulang dari potret yang sama
  /// memberi hasil identik meski presensinya berubah kemudian.
  snapshot Json

  createdAt DateTime @default(now()) @map("created_at")

  run    PayrollRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  lines  PayslipLine[]
  traces CalculationTrace[]

  @@unique([runId, employeeId])
  @@index([tenantId, employeeId])
  @@map("payslips")
  @@schema("payroll")
}

/// Satu baris pada slip gaji.
///
/// Kode dan nama komponen DIDENORMALISASI. Slip berlaku bertahun-tahun, dan
/// mengganti nama komponen tidak boleh mengubah slip yang sudah diterbitkan.
model PayslipLine {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  payslipId   String @map("payslip_id") @db.Uuid
  componentId String @map("component_id") @db.Uuid

  componentCode String        @map("component_code")
  componentName String        @map("component_name")
  type          ComponentType
  amount        Decimal       @db.Decimal(18, 2)
  sortOrder     Int           @default(0) @map("sort_order")

  payslip   Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([payslipId, sortOrder])
  @@map("payslip_lines")
  @@schema("payroll")
}

/// Jejak perhitungan: satu baris per angka, memuat formula dan variabelnya.
///
/// Saat karyawan menyanggah gajinya, HR menunjukkan rinciannya alih-alih
/// berdebat. Tanpa ini, satu-satunya jawaban atas "kenapa potongan saya segini"
/// adalah "begitu hasil sistemnya".
model CalculationTrace {
  id            BigInt  @id @default(autoincrement())
  tenantId      String  @map("tenant_id") @db.Uuid
  payslipId     String  @map("payslip_id") @db.Uuid
  componentCode String  @map("component_code")

  expression  String?
  /// Nilai setiap variabel pada saat dihitung.
  inputs      Json
  result      Decimal @db.Decimal(18, 2)
  /// Penjelasan satu kalimat untuk ditampilkan ke karyawan.
  explanation String?

  createdAt DateTime @default(now()) @map("created_at")

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@map("calculation_traces")
  @@schema("payroll")
}
