# Konfigurasi untuk docker-compose.yml (tumpukan penuh).
#
#   cp ops/.env.compose.example ops/.env
#   docker compose -f ops/docker-compose.yml --env-file ops/.env up --build
#
# Di produksi, nilai-nilai ini datang dari manajer rahasia, bukan dari berkas.

POSTGRES_PASSWORD=hrms_dev_password
APP_DB_PASSWORD=hrms_app_password
WORKER_DB_PASSWORD=hrms_worker_password
PLATFORM_DB_PASSWORD=hrms_platform_password

# Dua rahasia BERBEDA. Bila keduanya sama, token tenant dan token admin masih
# tetap terpisah (audience-nya berbeda dan rahasia admin diturunkan ulang),
# tetapi memisahkannya di sini menghapus satu ketergantungan pada detail itu.
# Bangkitkan dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only-change
ADMIN_JWT_SECRET=dev-only-admin-secret-dev-only-admin-secret-dev-only

WEB_PORT=3000
POSTGRES_PORT=5433
