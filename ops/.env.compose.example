# Konfigurasi untuk docker-compose.yml (tumpukan penuh).
#
#   cp ops/.env.compose.example ops/.env
#   docker compose -f ops/docker-compose.yml --env-file ops/.env up --build
#
# Di produksi, nilai-nilai ini datang dari manajer rahasia, bukan dari berkas.

POSTGRES_PASSWORD=hrms_dev_password
APP_DB_PASSWORD=hrms_app_password
WORKER_DB_PASSWORD=hrms_worker_password
PLATFORM_DB_PASSWORD=hrms_platform_password

# Kunci penandatangan token, satu pasang per bidang (tenant dan admin). HS256
# tidak ada lagi (PS-08, ADR-038). Bangkitkan dengan:
#   node ops/scripts/generate-jwt-keys.mjs
#   node ops/scripts/generate-jwt-keys.mjs EdDSA admin
JWT_PRIVATE_JWK=
JWT_PUBLIC_JWKS=
ADMIN_JWT_PRIVATE_JWK=
ADMIN_JWT_PUBLIC_JWKS=

# Kunci data pribadi dan control plane, masing-masing 32 byte base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=
PII_INDEX_KEY=
PLATFORM_ENCRYPTION_KEY=

WEB_PORT=3000
POSTGRES_PORT=5433
