# --- Database -----------------------------------------------------------------
# Owner connection. DDL only: migrations, seeds, schema introspection.
# The application must never use this.
DATABASE_URL="postgresql://hrms_owner:hrms_dev_password@localhost:5433/hrms?schema=public"

# Runtime connection. NOBYPASSRLS, no table ownership. Everything the app does
# at request time goes through this, so RLS is always in force.
DATABASE_URL_APP="postgresql://hrms_app:hrms_app_password@localhost:5433/hrms?schema=public"

# Koneksi proses latar. Sama seperti aplikasi, ditambah satu kebijakan sempit:
# boleh membaca outbox lintas tenant. Pada tabel lain ia sama terkurungnya.
DATABASE_URL_WORKER="postgresql://hrms_worker:hrms_worker_password@localhost:5433/hrms?schema=public"

# --- Auth ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-change-me-dev-only-change-me-dev-only-change"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- App ----------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Control plane ------------------------------------------------------------
# Principal terpisah. Tidak memiliki GRANT ke auth.users, iam.*, maupun audit.*.
DATABASE_URL_PLATFORM="postgresql://hrms_platform:hrms_platform_password@localhost:5433/hrms?schema=public"
ADMIN_JWT_SECRET="dev-only-admin-secret-dev-only-admin-secret-dev-only"

# Cookie sesi memakai flag Secure secara default. Disetel "false" HANYA untuk
# menguji build produksi lewat HTTP di mesin sendiri; jangan pernah di produksi.
# COOKIE_SECURE=false

# --- Enkripsi data pribadi ---------------------------------------------------
PII_ENCRYPTION_KEY="ganti-dengan-32-byte-base64"
PII_INDEX_KEY="ganti-dengan-32-byte-base64-berbeda"

# Kunci LAMA yang hanya boleh MEMBACA, dipisah koma. Diisi hanya selama rotasi
# berlangsung, dan DIHAPUS setelah `pnpm --filter @hrms/worker pii:rotate`
# selesai — prosedurnya di ops/RUNBOOK.md §8.
#
# Membiarkannya terisi setelah rotasi selesai membuat kunci lama tetap hidup di
# produksi tanpa batas waktu, dan itulah yang membuat rotasi kehilangan artinya.
PII_ENCRYPTION_KEYS_OLD=""
PII_INDEX_KEYS_OLD=""

# --- Email --------------------------------------------------------------------
# Tanpa RESEND_API_KEY + EMAIL_FROM, transport jatuh ke "console": email dicetak
# ke log, tidak dikirim. Itu default yang disengaja — lingkungan pengembangan
# yang diam-diam mengirim email ke alamat pelanggan pada berkas seed adalah
# kesalahan yang hanya dapat dilakukan sekali.
# RESEND_API_KEY=""
# EMAIL_FROM="HRMS <noreply@perusahaan.co.id>"
APP_BASE_URL="http://localhost:3000"

# --- Penyimpanan berkas -------------------------------------------------------
# Penyimpanan lokal, sesuai topologi satu VPS (PLAN/12 §3.2). Antarmukanya
# sempit sehingga penggantinya ke S3-compatible hanya menyentuh satu berkas.
#
# PERINGATAN: `ops/scripts/backup.sh` mengarsipkan satu direktori — `.storage`,
# atau `HRMS_STORAGE_DIR` bila disetel. Mengarahkan salah satu variabel di bawah
# ke luar direktori itu berarti berkasnya TIDAK ikut tercadangkan, dan itu tidak
# akan terlihat sampai ada yang mencoba memulihkannya.
#
# Foto presensi dihapus otomatis setelah 90 hari; catatan presensinya tetap utuh.
PHOTO_STORAGE_DIR="./.storage/attendance-photos"

# Dokumen karyawan: KTP, KK, NPWP, ijazah, KITAS, IMTA, SIM. Tidak dihapus
# otomatis — periodenya keputusan hukum, lihat PLAN/13.
DOCUMENT_STORAGE_DIR="./.storage/employee-documents"

# Lampiran pengajuan cuti: surat dokter, surat keterangan. Surat dokter adalah
# DATA KESEHATAN — kategori data pribadi spesifik menurut UU PDP Pasal 4 ayat
# (2). Lampiran yang diunggah tetapi pengajuannya tidak jadi dikirim dibuang
# otomatis setelah 24 jam.
LEAVE_ATTACHMENT_STORAGE_DIR="./.storage/leave-attachments"

# --- Web Push -----------------------------------------------------------------
# Dibangkitkan sekali: node ops/scripts/generate-vapid.mjs
#
# Kunci ini MENANDATANGANI permintaan ke layanan push peramban (FCM, Mozilla,
# Apple). Ia bukan kunci enkripsi payload — payload dienkripsi dengan kunci milik
# masing-masing perangkat.
#
# Dibiarkan kosong berarti push tidak aktif, dan itu keadaan yang sah: seluruh
# notifikasi penting tetap dikirim lewat email. Push adalah tambahan, bukan
# pengganti — di iOS ia hanya berfungsi bila PWA sudah dipasang ke Layar Utama
# (dokumen 04 §R52), sehingga menggantungkan kabar penting padanya berarti
# memindahkannya ke saluran yang diam-diam tidak sampai untuk separuh pengguna.
#
# PERINGATAN: mengganti pasangan kunci ini membatalkan SELURUH langganan yang
# sudah ada. Setiap perangkat harus berlangganan ulang, dan tidak ada yang
# memberi tahu penggunanya — notifikasi hanya berhenti datang.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@localhost"
