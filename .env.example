# --- Database -----------------------------------------------------------------
# Owner connection. DDL only: migrations, seeds, schema introspection.
# The application must never use this.
DATABASE_URL="postgresql://hrms_owner:hrms_dev_password@localhost:5433/hrms?schema=public"

# Runtime connection. NOBYPASSRLS, no table ownership. Everything the app does
# at request time goes through this, so RLS is always in force.
DATABASE_URL_APP="postgresql://hrms_app:hrms_app_password@localhost:5433/hrms?schema=public"

# Bidang auth (PLAN/14 tahap 5). Peran hrms_auth menjangkau auth, iam, tenant,
# audit, messaging — dan TIDAK SATU PUN tabel di employee, attendance, leave,
# atau payroll. Komponen yang memegang hash kata sandi tidak boleh sekaligus
# menjadi jalan menuju gaji dan NIK semua orang.
#
# Bila kosong, koneksi app dipakai dan perilakunya persis seperti sebelumnya.
DATABASE_URL_AUTH="postgresql://hrms_auth:hrms_auth_password@localhost:5433/hrms?schema=public"

# Koneksi proses latar. Sama seperti aplikasi, ditambah satu kebijakan sempit:
# boleh membaca outbox lintas tenant. Pada tabel lain ia sama terkurungnya.
DATABASE_URL_WORKER="postgresql://hrms_worker:hrms_worker_password@localhost:5433/hrms?schema=public"

# --- Auth ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# --- Penandatanganan token (PLAN/14 tahap 1) ---------------------------------
#
# Bangkitkan dengan: pnpm jwt:keys           (EdDSA, disarankan)
#                    pnpm jwt:keys RS256     (bila SSO enterprise akan datang)
#
# JWT_PRIVATE_JWK hanya milik yang MENERBITKAN token. Setelah auth dipisah
# (PLAN/14 tahap 6) ia TIDAK BOLEH ada di environment backend maupun worker:
# service yang memegangnya dapat menerbitkan token atas nama pengguna mana pun
# di tenant mana pun — justru sifat yang hendak dihapus oleh pemisahan itu.
#
# JWT_PUBLIC_JWKS adalah SET. Untuk rotasi, TAMBAHKAN kunci baru ke set lalu
# alihkan JWT_PRIVATE_JWK; kunci lama dibuang setelah token terakhir yang
# ditandatanganinya kedaluwarsa. Tanpa jeda itu, rotasi mengeluarkan semua
# pengguna sekaligus.
JWT_PRIVATE_JWK=""
JWT_PUBLIC_JWKS=""

# Rahasia HS256 lama. Selama masih terisi, token yang ditandatanganinya TETAP
# diterima — supaya penerapan kunci asimetris tidak mematikan sesi yang sedang
# berjalan. HAPUS setelah satu masa berlaku token akses berlalu: rahasia
# simetris tidak dapat membedakan "boleh memverifikasi" dari "boleh menerbitkan",
# dan selama ia ada, pemisahan service tidak memberi jaminan apa pun.
JWT_SECRET="dev-only-change-me-dev-only-change-me-dev-only-change"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- App ----------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Control plane ------------------------------------------------------------
# Principal terpisah. Tidak memiliki GRANT ke auth.users, iam.*, maupun audit.*.
DATABASE_URL_PLATFORM="postgresql://hrms_platform:hrms_platform_password@localhost:5433/hrms?schema=public"
# Control plane menandatangani dengan kunci SENDIRI: pnpm jwt:keys EdDSA admin
#
# Terpisah dengan sengaja. Token tenant dan token superuser tidak boleh dapat
# saling diverifikasi walaupun pemeriksaan audience (P11) hilang atau keliru —
# satu pasang kunci bersama akan menjadikan `aud` satu-satunya penghalang antara
# sesi tenant dan control plane. Keduanya bermigrasi sendiri-sendiri.
ADMIN_JWT_PRIVATE_JWK=""
ADMIN_JWT_PUBLIC_JWKS=""

ADMIN_JWT_SECRET="dev-only-admin-secret-dev-only-admin-secret-dev-only"

# Cookie sesi memakai flag Secure secara default. Disetel "false" HANYA untuk
# menguji build produksi lewat HTTP di mesin sendiri; jangan pernah di produksi.
# COOKIE_SECURE=false

# --- Enkripsi data pribadi ---------------------------------------------------
PII_ENCRYPTION_KEY="ganti-dengan-32-byte-base64"
PII_INDEX_KEY="ganti-dengan-32-byte-base64-berbeda"

# Kunci LAMA yang hanya boleh MEMBACA, dipisah koma. Diisi hanya selama rotasi
# berlangsung, dan DIHAPUS setelah `pnpm --filter @hrms/worker pii:rotate`
# selesai — prosedurnya di ops/RUNBOOK.md §8.
#
# Membiarkannya terisi setelah rotasi selesai membuat kunci lama tetap hidup di
# produksi tanpa batas waktu, dan itulah yang membuat rotasi kehilangan artinya.
PII_ENCRYPTION_KEYS_OLD=""
PII_INDEX_KEYS_OLD=""

# --- Email --------------------------------------------------------------------
# Tanpa RESEND_API_KEY + EMAIL_FROM, transport jatuh ke "console": email dicetak
# ke log, tidak dikirim. Itu default yang disengaja — lingkungan pengembangan
# yang diam-diam mengirim email ke alamat pelanggan pada berkas seed adalah
# kesalahan yang hanya dapat dilakukan sekali.
# RESEND_API_KEY=""
# EMAIL_FROM="HRMS <noreply@perusahaan.co.id>"
APP_BASE_URL="http://localhost:3000"

# --- Penyimpanan berkas -------------------------------------------------------
# Penyimpanan lokal, sesuai topologi satu VPS (PLAN/12 §3.2). Antarmukanya
# sempit sehingga penggantinya ke S3-compatible hanya menyentuh satu berkas.
#
# PERINGATAN: `ops/scripts/backup.sh` mengarsipkan satu direktori — `.storage`,
# atau `HRMS_STORAGE_DIR` bila disetel. Mengarahkan salah satu variabel di bawah
# ke luar direktori itu berarti berkasnya TIDAK ikut tercadangkan, dan itu tidak
# akan terlihat sampai ada yang mencoba memulihkannya.
#
# Foto presensi dihapus otomatis setelah 90 hari; catatan presensinya tetap utuh.
PHOTO_STORAGE_DIR="./.storage/attendance-photos"

# Dokumen karyawan: KTP, KK, NPWP, ijazah, KITAS, IMTA, SIM. Tidak dihapus
# otomatis — periodenya keputusan hukum, lihat PLAN/13.
DOCUMENT_STORAGE_DIR="./.storage/employee-documents"

# Lampiran pengajuan cuti: surat dokter, surat keterangan. Surat dokter adalah
# DATA KESEHATAN — kategori data pribadi spesifik menurut UU PDP Pasal 4 ayat
# (2). Lampiran yang diunggah tetapi pengajuannya tidak jadi dikirim dibuang
# otomatis setelah 24 jam.
LEAVE_ATTACHMENT_STORAGE_DIR="./.storage/leave-attachments"

# --- Web Push -----------------------------------------------------------------
# Dibangkitkan sekali: node ops/scripts/generate-vapid.mjs
#
# Kunci ini MENANDATANGANI permintaan ke layanan push peramban (FCM, Mozilla,
# Apple). Ia bukan kunci enkripsi payload — payload dienkripsi dengan kunci milik
# masing-masing perangkat.
#
# Dibiarkan kosong berarti push tidak aktif, dan itu keadaan yang sah: seluruh
# notifikasi penting tetap dikirim lewat email. Push adalah tambahan, bukan
# pengganti — di iOS ia hanya berfungsi bila PWA sudah dipasang ke Layar Utama
# (dokumen 04 §R52), sehingga menggantungkan kabar penting padanya berarti
# memindahkannya ke saluran yang diam-diam tidak sampai untuk separuh pengguna.
#
# PERINGATAN: mengganti pasangan kunci ini membatalkan SELURUH langganan yang
# sudah ada. Setiap perangkat harus berlangganan ulang, dan tidak ada yang
# memberi tahu penggunanya — notifikasi hanya berhenti datang.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@localhost"

# --- Redis (PLAN/14 §9.2) ----------------------------------------------------
#
# Opsional, dan tetap opsional. Tanpa ini pembatas laju memakai penghitung dalam
# proses dan aplikasi berjalan persis seperti sebelumnya — satu kontainer tidak
# butuh Redis, dan PLAN/12 §3.2 menjual hal itu sebagai fitur.
#
# WAJIB begitu `web` berjalan lebih dari satu replika. Penghitung dalam proses
# membuat setiap replika menghitung sendiri: dua replika mengizinkan dua kali
# lipat, empat replika empat kali lipat — tanpa galat, tanpa log, dan tanpa cara
# mengetahuinya dari luar. Angka di konfigurasi bukan angka yang berlaku.
#
# Isinya hanya penghitung berumur pendek. Kehilangan seluruhnya saat restart
# berarti satu jendela laju terlewat, bukan data yang hilang.
REDIS_URL="redis://localhost:6380"

# --- Pemisahan layanan auth (PLAN/14 tahap 6) --------------------------------
#
# KOSONG = monolit. Backend mengambil keputusan otorisasi di dalam prosesnya
# sendiri, persis seperti sebelumnya, dan itulah penerapan bawaan yang utuh.
#
# Diisi = backend BERTANYA ke layanan auth pada setiap request terautentikasi.
# Ia tidak lagi memverifikasi token dan tidak lagi menghitung izin sendiri —
# tepatnya satu komponen memegang kunci penanda tangan dan tepatnya satu
# memutuskan arti sebuah token.
#
# Peralihannya adalah variabel lingkungan, bukan percabangan kode. Itu yang
# membuat tahap 6 benar-benar dapat dibatalkan.
AUTH_SERVICE_URL=""

# Rahasia bersama antara backend dan layanan auth, dan tidak dengan yang lain.
# Menjaga /internal/* ketika proxy gagal menjaganya — proxy yang salah konfigurasi
# jauh lebih mungkin terjadi daripada rahasia yang bocor, dan satu baris routing
# tidak boleh menjadi satu-satunya penghalang menuju endpoint yang memutuskan
# arti token.
#
# Kelemahannya nyata dan dicatat di PLAN/14 §10.6: ia tidak berotasi sendiri dan
# sekuat lingkungan yang memuatnya. Cukup untuk dua kontainer di satu jaringan,
# dan HARUS diganti sebelum keduanya berada di jaringan berbeda.
AUTH_INTERNAL_SECRET=""

# Port layanan auth saat dijalankan langsung untuk pengembangan.
AUTH_PORT="3001"
